# conboard backend — PostgreSQL connection template.
# Copy to backend/db/.env (gitignored) and adjust. NEVER commit real secrets.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=conboard
POSTGRES_USER=conboard
POSTGRES_PASSWORD=conboard

# libpqxx / psql connection string built from the above, e.g.:
# postgresql://conboard:conboard@localhost:5432/conboard

# conboard backend runtime config. Copy to backend/db/.env (gitignored) and adjust,
# or set these in the systemd unit (assets/backend.service). No secrets here.

# SQLite rules-library file (the device-local authoring/portability DB). Created on
# first boot; tables are created by the backend via the generated DAO create_table().
CONBOARD_DB=/conboard/backend/data/conboard.db

# REST + websocket bind. nginx proxies the public surface; bind localhost.
CONBOARD_HTTP_HOST=127.0.0.1
CONBOARD_HTTP_PORT=8080

# gRPC listen address (scaffolding for the future dispatcher-over-gRPC migration).
CONBOARD_GRPC_ADDR=127.0.0.1:50051

# REST base path.
CONBOARD_API_BASE=/api/v1

// conboard rules-library domain. Hand this to harpia to generate the C++ structs,
// JSON, SOCI-backed CRUDL DAO, REST (Crow) and gRPC. See README.md in this folder
// for the full rationale and the harpia authoring constraints. Mirrors
// frontend/console/src/model/rules.ts. Comments here stay punctuation-plain because
// the harpia lexer is fragile about comment content.

import "types.harpia";

// enums. one enumerator MUST be 0.

enum device_type {
    dt_midi = 0;
    dt_joystick;
    dt_keyboard;
    dt_mouse;
}

enum trigger_kind {
    tk_midi = 0;
    tk_evdev;
}

enum trigger_edge {
    edge_press = 0;
    edge_release;
    edge_hold;
    edge_hold_once;
    edge_higher;
    edge_lower;
    edge_spot;
}

enum action_kind {
    ak_midi = 0;
    ak_keyboard;
    ak_mouse;
}

enum key_type {
    kt_text = 0;
    kt_one_key;
    kt_hot_key;
}

enum hold_mode {
    hm_not_hold = 0;
    hm_hold;
    hm_hold_once;
}

// midi_mode. MIDI-specific operation mode on a trigger, mirrors the firmware
// midi_action_mode. mm_normal is the default matched exactly. see rules.ts MidiMode.

enum midi_mode {
    mm_normal = 0;
    mm_trigger_higher;
    mm_trigger_lower;
    mm_spot;
    mm_blink;
}

// hmi_control. one named physical event off the HMI panel local hardware,
// LowLevel HMI, two rotary encoders (each with its own pushbutton) plus two
// standalone pushbuttons. Not evdev, this hardware is read directly over
// libgpiod, never through the kernel input subsystem.

enum hmi_control {
    hc_encoder1_ccw = 0;
    hc_encoder1_cw;
    hc_encoder1_press;
    hc_encoder2_ccw;
    hc_encoder2_cw;
    hc_encoder2_press;
    hc_button1_press;
    hc_button2_press;
}

// hmi_nav_key. the LVGL group navigation key a bound control should send.
// Mirrors the LV_KEY_ constants app_shell and lvgl_glue already build
// screens against, so a binding is directly actionable with no extra
// translation layer.

enum hmi_nav_key {
    nk_next = 0;
    nk_prev;
    nk_select;
    nk_back;
    nk_up;
    nk_down;
}

// trigger. rule input, flattened MidiTrigger or EvdevTrigger.

stream pull push event message trigger {
    trigger_kind kind;
    optional int b0;
    optional int b1;
    optional int b2;
    optional midi_mode midi_mode;
    optional string code;
    optional trigger_edge edge;
    optional int value;
    optional int interval;
    optional int delay;
} trigger_table;

// output_action. flattened MidiAction or KeyboardAction or MouseAction.
// mouse fields are strings to preserve board-file fidelity.

stream pull push event message output_action {
    action_kind kind;
    optional int delay;
    optional int b0;
    optional int b1;
    optional int b2;
    optional string data;
    optional key_type key_type;
    optional hold_mode hold;
    optional string dx;
    optional string dy;
    optional string wheel_move;
    optional string gotox;
    optional string gotoy;
    optional string click;
    optional string right_click;
} output_action_table;

// rule. trigger to output list, plus optional ChangeMode.

stream pull push event message rule {
    trigger input;
    repeteable output_action outputs;
    optional int change_mode_enable;
    optional int change_mode_to;
} rule_table;

// mode. id, active, header actions, and the rules.

stream pull push event message mode {
    int mode_id;
    int active;
    repeteable output_action mode_header;
    repeteable rule rules;
} mode_table;

// board. the top-level device profile.

stream pull push event message board {
    string name;
    device_type type;
    int timeout;
    string input;
    string output;
    optional string exec;
    optional string port;
    optional map<string,string> generics;
    optional map<string,string> tags;
    repeteable output_action header_actions;
    repeteable mode modes;
} board_table;

// hmi_binding. maps one physical HMI control to one LVGL nav key. Data, not
// compiled-in wiring, so which control does what on the panel is
// configurable over REST without a conHMI rebuild. Global across screens
// for now, conHMI shares one LVGL group across every pushed screen today,
// see LowLevel/HMI/src/main.cpp.

stream pull push event message hmi_binding {
    hmi_control control;
    hmi_nav_key nav_key;
} hmi_binding_table;

{
    "_TEMPLATE": "Copy to boards/<YourMouse>.json and edit. Fill ID_VENDOR_ID/ID_MODEL_ID from `lsusb`, and DEVICE.name + DEVICE.input from `cat /proc/bus/input/devices` (the mouse's Name=). Placeholders below (REPLACE_*) will never match a real device until edited. Buttons are BTN_LEFT/BTN_RIGHT/BTN_MIDDLE (press/release); motion/wheel are REL_X/REL_Y/REL_WHEEL/REL_HWHEEL with higher/lower/spot + value (see LowLevel/Common/src/evMatch.cpp). Map outputs to type:keyboard — mouse/joystick HID outputs are currently no-ops.",
    "DEVICE": {
        "timeout": 0,
        "type": "mouse",
        "name": "REPLACE_WITH_A_NAME",
        "input": "REPLACE_WITH_EVIOCGNAME",
        "output": ""
    },
    "header": {
        "identifier": {
            "generics": {},
            "tags": {
                "ID_BUS": "usb",
                "ID_VENDOR_ID": "REPLACE_VID",
                "ID_MODEL_ID": "REPLACE_PID"
            },
            "executable": {
                "exec": "/conboard/LowLevel/Mouse/build/conMouse"
            }
        },
        "actions": []
    },
    "body": {
        "modes": [
            {
                "id": 0,
                "active": true,
                "mode_header": { "actions": [] },
                "actions": [
                    {
                        "input":  { "type": "mouse", "code": "BTN_LEFT", "mode": "press" },
                        "output": [ { "type": "keyboard", "data": "left click", "keyType": "text", "hold": "not_hold", "delay": 0 } ]
                    },
                    {
                        "input":  { "type": "mouse", "code": "BTN_RIGHT", "mode": "press" },
                        "output": [ { "type": "keyboard", "data": "right click", "keyType": "text", "hold": "not_hold", "delay": 0 } ]
                    },
                    {
                        "input":  { "type": "mouse", "code": "REL_WHEEL", "mode": "higher", "value": 0 },
                        "output": [ { "type": "keyboard", "data": "wheel up", "keyType": "text", "hold": "not_hold", "delay": 0 } ]
                    },
                    {
                        "input":  { "type": "mouse", "code": "REL_WHEEL", "mode": "lower", "value": 0 },
                        "output": [ { "type": "keyboard", "data": "wheel down", "keyType": "text", "hold": "not_hold", "delay": 0 } ]
                    }
                ]
            }
        ]
    }
}

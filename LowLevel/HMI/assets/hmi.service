[Unit]
Description=conHMI - local screen/buttons/encoders UI.
Documentation=https://github.com/rafaelchiafarelli/conboard
After=backend.service
Wants=backend.service

[Service]
User=root
# Needs root for /dev/spidevN.N and gpiochip access. Long-running (LVGL loop),
# so Type=simple (see dispatcher.service's note on why oneshot is wrong here).
Type=simple
Environment=CONHMI_REST_BASE=http://127.0.0.1:8080/api/v1
ExecStart=/conboard/LowLevel/HMI/build/conHMI --panel st7789
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
